### backupTW ###

# The target uses a synchronized root group, so *any* .swift file dropped under
# backupTW/ joins the build automatically — and would just as automatically be
# picked up by `git add`. A Secrets.swift holding the TW FidO service ID and AES
# key is exactly the file that gets created in a hurry and committed by accident.
# Prefer scheme environment variables (TWFIDO_SP_SERVICE_ID / TWFIDO_SP_AES_KEY),
# which never reach the working tree at all; this line is the backstop.
Secrets.swift
*.secrets.swift

# Captured TW FidO round trips. A signed_response holds a real certificate chain
# and the hashed national ID; sp_ticket payloads carry the transaction identity.
# Useful while debugging, never something to publish.
fido-*.json
*-signed-response.json
signed-response*.json
sp-ticket*.json
# The name scripts/twfido-sign.mjs actually writes. The patterns above were
# written from the shape of the data rather than from the tool in this repo, and
# missed it: --output defaults outside the working tree, but pointing it at the
# repo while debugging is the obvious thing to do.
tw_fido_sign_response.json
*tw_fido_sign_response*.json

# Issued credentials. A compact JWS is not encrypted: its payload is the
# national ID data in base64url, readable by anyone who gets the file.
*.jws

# Local-only replay of a real card presentation — contains real cardholder data, never commit
backupTWTests/ReplayLocal*.swift
build/
build-device/
build-sim/
tools/official-document-physical-card-signer/target/
