<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Written in 正體中文 rather than English because the app's interface
	     language is 正體中文, and this string is shown by iOS inside its own
	     permission alert where nothing else of ours can explain it. It names
	     what the camera reads (a QR code), what it does not do (record or
	     upload), and that the check works with the phone offline — the property
	     the whole feature exists for. There is no InfoPlist.xcstrings in this
	     target, so this value is not localizable through the string catalogue. -->
	<key>NSCameraUsageDescription</key>
	<string>需要相機才能掃描查驗用的 QR Code：出示證件時掃描查驗者的條碼，查驗他人證件時掃描對方的條碼。全程離線比對，不會拍照、不會錄影，也不會將任何影像或資料上傳。</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>mobilemoica</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>tw.bonds.backupTW</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>backuptw</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Bond</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
