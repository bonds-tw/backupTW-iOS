<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Bond</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>tw.bonds.backupTW</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>backuptw</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>tw.bonds.backupTW.credential-offer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>openid-credential-offer</string>
			</array>
		</dict>
		<!-- modadigitalwallet:// — 台灣數位憑證皮夾 官方 App 的自訂 scheme.
		     This REVERSES the earlier deliberate decision NOT to register it
		     (documented in TWDIW/CredentialOffer.swift). Why register it now:
		     the telecom 門號電子卡 flow finishes inside the carrier's own app,
		     which hands the credential offer back only as
		     modadigitalwallet://credential_offer?credential_offer_uri=… — the OS
		     routes that to whichever app registers the scheme, so unless we
		     register it we never receive the offer and the card can never be
		     collected. The trust gates still protect us: an inbound offer under
		     this scheme goes through exactly the same CredentialOfferLink.parse →
		     CredentialCollection → IssuerAuthorization two gates as any other, so
		     an untrusted issuer is still refused. The cost: we now share this
		     scheme with the official app, and iOS leaves routing undefined when
		     both are installed — so for reliable delivery the official 皮夾 app
		     must be removed. This is stated in the user-facing entry that opens
		     the flow (UseViewController「申請電信門號卡」). -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>tw.bonds.backupTW.modadigitalwallet</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>modadigitalwallet</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>mobilemoica</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>出示證件時，可以改用藍牙把證件直接傳給查驗方，不必舉著螢幕讓對方掃十幾張條碼。藍牙只在你按下出示、且對方的條碼指定了這次連線時才開啟，用完就關閉；全程不連任何伺服器，也不會保留對方的裝置資訊。</string>
	<key>NSCameraUsageDescription</key>
	<string>需要相機才能掃描查驗用的 QR Code：出示證件時掃描查驗者的條碼，查驗他人證件時掃描對方的條碼。全程離線比對，不會拍照、不會錄影，也不會將任何影像上傳。</string>
	<key>NSFaceIDUsageDescription</key>
	<string>使用 Face ID 解鎖有備而來，避免其他拿到這支手機的人查看或出示你的證件。生物辨識資料只由 iOS 在裝置上處理，不會交給本 App。</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
