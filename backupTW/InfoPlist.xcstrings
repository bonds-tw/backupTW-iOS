    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera scans verification QR codes: a checker's code when you present a document, or the other person's code when you check theirs. Everything is matched offline — no photo, no video, and nothing is uploaded."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要相機才能掃描查驗用的 QR Code：出示證件時掃描查驗者的條碼，查驗他人證件時掃描對方的條碼。全程離線比對，不會拍照、不會錄影，也不會將任何影像或資料上傳。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Face ID to unlock 有備而來 and keep anyone else holding this phone from viewing or presenting your credentials. Biometric data is handled on-device by iOS and never given to this app."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Face ID 解鎖有備而來，避免其他拿到這支手機的人查看或出示你的證件。生物辨識資料只由 iOS 在裝置上處理，不會交給這個 App。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
