          "stringUnit": {
            "state": "translated",
            "value": "證明你持有有效的自然人憑證"
          }
        }
      }
    },
    "Quoted from their document: %@": {
      "comment": "VoiceOver framing for a disclosed field's value",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引述自對方文件：%@"
          }
        }
      }
    },
    "Read %1$d of %2$d codes": {
      "comment": "Multi-frame scan progress",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已讀取 %1$d／%2$d 張"
          }
        }
      }
    },
    "Ready — waiting for the checker's phone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已就緒——等待查驗方的手機。"
