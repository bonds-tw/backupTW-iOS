    },
    "Issue date": {
      "comment": "field label",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發證日期"
          }
        }
      }
    },
    "National ID did:key": {
      "comment": "national ID own DID field",
      "localizations": {
