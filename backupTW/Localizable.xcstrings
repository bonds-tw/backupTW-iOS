    },
    "This proof file could not be read.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個證明檔案讀不出來。"
          }
        }
      }
    },
    "This proof file is larger than a real proof ever is, so it was not opened.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個證明檔比真正的證明大得多，因此沒有開啟。"
