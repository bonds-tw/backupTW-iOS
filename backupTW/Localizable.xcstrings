    "Could not load the list of trusted issuers. Check your connection and try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得可信任發卡單位的清單。請檢查網路後再試一次。"
          }
        }
      }
    },
    "Could not reach the card service. Check your connection and try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連上發卡服務。請檢查網路連線後再試一次。"
          }
        }
      }
    },
    "Could not reach the digital certificate service.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到行動自然人憑證服務。"
