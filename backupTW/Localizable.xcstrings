      "extractionState": "manual"
    },
    "Scan the checker's code and %@ goes straight to their phone — about twenty seconds. Nothing is stored anywhere else.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描查驗方的碼，%@ 直接送到對方手機——大約二十秒。不會留在任何其他地方。"
          }
        }
      }
    },
    "Scan their document": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描對方的證件"
          }
        }
      }
    },
    "Scanning this only tells the other phone where to send the proof. It is not a one-time number — the proof was made before you asked for it, so nothing here stops the same proof being sent again later.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃這個碼只是告訴對方的手機要把證明送到哪裡。它不是一次性亂數——那份證明在你要求之前就已經產生好了，所以沒有任何機制阻止同一份證明日後再被送一次。"
          }
        }
      }
    },
    "Secure Enclave": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全隔離區（Secure Enclave）"
          }
        }
      }
    },
    "Self-check": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自我檢查"
          }
        }
      }
    },
    "Send the number to 內政部": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把號碼送給內政部"
          }
        }
      }
    },
    "Send the same proof again": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再送一次同一份證明"
          }
        }
      }
    },
    "Send this proof over Bluetooth": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用藍牙把這份證明傳給查驗方"
          }
        }
      }
    },
    "Sending over Bluetooth… %d%%": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙傳送中… %d%%"
          }
        }
      }
    },
    "Sending the proof": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送證明"
          }
        }
      }
    },
    "Sending… %d%%": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送中… %d%%"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        }
      }
    },
    "Show %d fields": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示 %d 個欄位"
          }
        }
      }
    },
    "Show %d fields (name included)": {
      "comment": "Present button",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出示 %d 個欄位（含姓名）"
          }
        }
      }
    },
    "Show my document": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出示我的證件"
          }
        }
      }
    },
    "Show only my name": {
      "comment": "Present button when nothing else is ticked",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只出示姓名"
          }
        }
      }
    },
    "Show your document?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要出示證件嗎？"
          }
        }
      }
    },
    "Showing this document always reveals your name, because it is written into the certificate that signs it. The same certificate goes to every checker, so any two of them can tell it was the same person.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出示這份證件一定會露出你的姓名——姓名寫在替它簽章的憑證裡。每個查驗方拿到的都是同一張憑證，所以任兩個查驗方都能看出是同一個人。"
          }
        }
      }
    },
    "Sign with your digital certificate": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用自然人憑證簽章"
          }
        }
      }
    },
    "Sign your national ID details": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署你的身分證欄位"
          }
        }
      }
    },
    "Signature": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽章"
          }
        }
      }
    },
    "Signature checking key": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽章驗證金鑰"
          }
        }
      }
    },
    "Signature proving key": {
      "comment": "ZK circuit asset",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽章證明金鑰"
          }
        }
      }
    },
    "Signed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成簽章"
          }
        }
      }
    },
    "Signed by": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署者"
          }
        }
      }
    },
    "Signed — %d signature(s), SubFilter %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有簽章——%d 份，SubFilter %@"
          }
        }
      }
    },
    "Signing": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署"
          }
        }
      }
    },
    "Signing again may add a second signature.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再簽一次可能會多一筆簽名。"
          }
        }
      }
    },
    "Signing has to go through the bonds-tw server, which this build can't reach.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽章必須經過 bonds-tw 伺服器，而這個版本連不到它。"
          }
        }
      }
    },
    "Signing key": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署金鑰"
          }
        }
      }
    },
    "Signing needs a service this build cannot reach, so the document could not be created even after fetching your data. Nothing is fetched.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽章需要一個這個版本連不到的服務，所以就算把你的資料抓下來也做不出證件。因此不會去抓。"
          }
        }
      }
    },
    "Signing needs the internet once, to send the proof.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署需要連一次網路，把證明送出去。"
          }
        }
      }
    },
    "Signing with a proof is switched off.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用證明簽署目前是關閉的。"
          }
        }
      }
    },
    "Signing would complete but never return to this app.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽章會完成，但永遠回不到這個 App。"
          }
        }
      }
    },
    "So the details on this screen are not left behind in the app switcher.": {
      "comment": "App switcher privacy cover",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以免這個畫面上的資料留在多工切換畫面裡。"
          }
        }
      }
    },
    "Some data could not be erased": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有部分資料無法刪除"
          }
        }
      }
    },
    "Something went wrong on this device.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機上出了問題。"
          }
        }
      }
    },
    "Start again": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開始"
          }
        }
      }
    },
    "Still true even when this passes:": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "就算通過了，以下仍然成立："
          }
        }
      }
    },
    "Still unproven": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍未證明的事"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        }
      }
    },
    "Stop this run?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要停止這次執行嗎？"
          }
        }
      }
    },
    "Stopped.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止。"
          }
        }
      }
    },
    "Storage": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存"
          }
        }
      }
    },
    "Storage unavailable": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存區無法使用"
          }
        }
      }
    },
    "Stored credentials": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的憑證"
          }
        }
      }
    },
    "Stored in the Keychain, not the Secure Enclave": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存在 Keychain，不是安全隔離區"
          }
        }
      }
    },
    "Successfully downloaded but processing error": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載成功，但後續處理錯誤"
          }
        }
      }
    },
    "Support and About": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援與關於"
          }
        }
      }
    },
    "That a registered issuing body signed these fields, and which body it was.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有登記的發行機關簽過這些欄位，而且是哪一個機關。"
          }
        }
      }
    },
    "That code could not be read. Ask them to show it again from the start.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個條碼讀不出來。請對方從第一張重新出示。"
          }
        }
      }
    },
    "That code has expired. Ask them to show a fresh one.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個碼已經過期了。請對方重新顯示一個。"
          }
        }
      }
    },
    "That code was made by a newer version of the app. Update this app first.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那個碼是較新版本的 App 產生的，請先更新這個 App。"
          }
        }
      }
    },
    "That is the code for checking a document, not a proof. Use 「出示我的證件」 instead.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那是查驗證件用的碼，不是查驗證明的。請改用「出示我的證件」。"
          }
        }
      }
    },
    "That is the code for sending a zero-knowledge proof, not for showing a document.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那是傳送零知識證明用的碼，不是出示證件用的。"
          }
        }
      }
    },
    "That list was made on %@.": {
      "comment": "Date of the revocation snapshot used",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該名單製作於 %@。"
          }
        }
      }
    },
    "That some holder of a certificate issued by MOICA-G3 supplied the signing material for this proof. Not that it was you, and not that it was made just now — the signing material never expires, so anybody who has ever held it can make this same proof without you.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某位 MOICA-G3 所發憑證的持有人，提供了這份證明所用的簽章材料。不代表那是你，也不代表是剛剛做的——簽章材料不會過期，任何拿過一次的人都能在你不在場時做出同一份證明。"
          }
        }
      }
    },
    "That somebody's real national ID certificate signed this, without revealing which one.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一張真的自然人憑證簽了這份證明，而不透露是哪一張。"
          }
        }
      }
    },
    "That the Ministry of the Interior's certificate signed these fields — checkable with no network at all.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內政部的憑證簽過這些欄位——完全不用網路就查得出來。"
          }
        }
      }
    },
    "That you hold a real national ID certificate, without revealing which one.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你持有一張真的自然人憑證，而不透露是哪一張。"
          }
        }
      }
    },
    "The TW FidO app is not on this phone": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機上找不到行動自然人憑證 App"
          }
        }
      }
    },
    "The caveats under each answer are the list the proof code itself carries, and whether a path exists at all is read from the same build switch the rest of the app reads. The wording of each answer is written by hand — it is this project's own account of its design, not a measurement.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個答案底下的但書，就是證明程式自己帶著的那份清單；某條路徑這個版本有沒有，也是讀跟 App 其他地方同一個編譯開關。至於每個答案怎麼措辭，是人寫的——那是這個專案對自己設計的說法，不是量出來的。"
          }
        }
      }
    },
    "The certificate authority file that ships with this app couldn't be read.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取 App 內建的憑證機構檔案。"
          }
        }
      }
    },
    "The certificate authority file that ships with this app has been altered, so it won't be used.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 內建的憑證機構檔案已遭竄改，不會使用。"
          }
        }
      }
    },
    "The certificate authority file that ships with this app is missing.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 內建的憑證機構檔案遺失了。"
          }
        }
      }
    },
    "The certificate authority that ships with this app expired on %@. Please update the app.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 內建的憑證機構已於 %@ 到期，請更新 App。"
          }
        }
      }
    },
    "The certificate authority that ships with this app isn't valid until %@. Check your device's date and time.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 內建的憑證機構要到 %@ 才生效，請檢查裝置的日期與時間。"
          }
        }
      }
    },
    "The certificate revocation list was not applied, so this proof would be refused.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有套用憑證撤銷清單，這個證明會被拒絕。"
          }
        }
      }
    },
    "The certificate that signed these details was issued by the government certification authority to “%@”. That names the signer — it does not mean the government checked the details below.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署這些欄位的憑證，是政府憑證機構簽發給「%@」的。這說明的是簽章者是誰——不代表政府查核過下面的欄位內容。"
          }
        }
      }
    },
    "The certificate that signed this document carries the holder's legal name, and it is sent to every checker whether or not they chose to disclose it. Any two checkers can tell it was the same person.": {
      "comment": "Shown alongside a successful offline verification",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "替這份文件簽章的憑證帶著持有人的法定姓名，無論他有沒有選擇揭露姓名，那張憑證都會送給每一個查驗方。任兩個查驗方都能看出是同一個人。"
          }
        }
      }
    },
    "The check on this device did not finish": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機上的驗證沒有完成"
          }
        }
      }
    },
    "The check ran but could not reach a verdict.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查跑完了，但無法判定結果。"
          }
        }
      }
    },
    "The checker shows a code first. It carries a one-time number that your document has to answer, which is what stops an old screenshot being reused.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查驗方會先出示一個條碼，裡面帶著一組一次性的數字，你的證件必須回應這組數字——這就是舊截圖無法重複使用的原因。"
          }
        }
      }
    },
    "The checker's phone has the document.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查驗方的手機已經收到這份證件。"
          }
        }
      }
    },
    "The checker's phone has the proof.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查驗方的手機已經收到這份證明。"
          }
        }
      }
    },
    "The connection ended before the whole document arrived.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線在整份證件送達前就結束了。"
          }
        }
      }
    },
    "The credential identifier is not usable.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證識別碼無法使用。"
          }
        }
      }
    },
    "The device's signing key could not be read.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取此裝置的簽署金鑰。"
          }
        }
      }
    },
    "The digital certificate service could not be reached.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上自然人憑證服務。"
          }
        }
      }
    },
    "The digital certificate service refused the request (%@).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行動自然人憑證服務拒絕了這個請求（%@）。"
          }
        }
      }
    },
    "The digital certificate service returned an unexpected response.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行動自然人憑證服務回傳了非預期的內容。"
          }
        }
      }
    },
    "The digital certificate that signed this document cannot be checked — most often because it has expired.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署這份文件的憑證無法查驗，最常見的原因是憑證已經過期。"
          }
        }
      }
    },
    "The digital certificate that signed this document has been revoked. The document needs to be issued again with a current certificate.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署這份文件的憑證已被撤銷。請用現行的憑證重新簽發一次。"
          }
        }
      }
    },
    "The document carries whether the holder had turned 18 when it was issued, signed by their digital certificate, and that line can be shown on its own without the date of birth. It is not anonymous: the same identifier appears every time, so different checkers can tell it is the same person.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證件裡帶有「發證當下是否已滿 18 歲」這一項，由持有人的自然人憑證一併簽署，可以單獨出示而不出示出生日期。但這不是匿名：每次出示都是同一個識別碼，不同查驗方仍能看出是同一個人。"
          }
        }
      }
    },
    "The document could not be signed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證件無法簽署"
          }
        }
      }
    },
    "The document could not be signed on this device.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件無法在此裝置上簽署。"
          }
        }
      }
    },
    "The download carries its own trust root. Re-signing these fields with this phone's key is weaker than what arrived — the credential design should use the original signature.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載下來的檔案自己就帶著信任根。用這支手機的金鑰重簽這些欄位，比原本收到的還弱——憑證設計應該改用原始簽章。"
          }
        }
      }
    },
    "The downloaded document is missing details this app needs, so it cannot be signed.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載回來的文件缺少本 App需要的欄位，無法簽署。"
          }
        }
      }
    },
    "The downloaded file was damaged. Please try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載的檔案已損毀，請再試一次。"
          }
        }
      }
    },
    "The files for creating a proof are ready, but the extra ones for checking it on this device aren't: %@": {
      "comment": "Assets stage: everything a proof needs installed, only the checking keys did not",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生證明的檔案已經備妥，但在這支手機上檢查證明的額外檔案沒有備妥：%@"
          }
        }
      }
    },
    "The holder signed these details with their own government-issued certificate. That confirms who is making the claim, not that the government has confirmed the details.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些欄位由持有人自己的自然人憑證簽署。這證明的是「誰在主張」，不是政府已經確認過這些內容。"
          }
        }
      }
    },
    "The holder was shown a different reason for this check than the one you asked for.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持證人看到的查驗事由與您提出的不同。"
          }
        }
      }
    },
    "The identifier survived being deleted": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "識別碼在刪除後仍然存活"
          }
        }
      }
    },
    "The lines below are the document's own words, quoted. This app checked the signature over them, not whether any of it is true.": {
      "comment": "Attribution above the fields a verified presentation disclosed",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以下是這份證件自己填的內容，原樣引述。本 App 只驗了它們的簽章，沒有查核內容是不是真的。"
          }
        }
      }
    },
    "The offline verification files aren't ready yet. Finish preparing them, then try again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離線驗證檔案還沒備妥。請先完成準備，再試一次。"
          }
        }
      }
    },
    "The one-time number is gone, so trying again means making a new proof.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性號碼已經用掉了，所以再試一次就要重做一份證明。"
          }
        }
      }
    },
    "The other device's clock is too far off for this to be checked.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方裝置的時間誤差太大，無法查驗。"
          }
        }
      }
    },
    "The other phone could not be reached.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上對方的手機。"
          }
        }
      }
    },
    "The other phone disconnected before the whole proof had been sent. Ask them to scan the code again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方的手機在證明送完之前就斷線了。請他重新掃描一次條碼。"
          }
        }
      }
    },
    "The other phone is not offering a document.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方的手機沒有在提供證件。"
          }
        }
      }
    },
    "The pairing code is down. This proof is being dealt with, so nobody else can send one until you ask for the next person.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對碼已經收起來了。這份證明還在處理，在你按下「查下一個人」之前，別人送不進來。"
          }
        }
      }
    },
    "The person holding this device signed this check": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持有這台裝置的人簽署了本次查驗"
          }
        }
      }
    },
    "The proof arrived damaged. Ask them to send it again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收到的證明有損毀，請對方重送一次。"
          }
        }
      }
    },
    "The proof carries a number that is the same for you every time you sign this wall. bonds.tw says it does not store it and does not publish it. Nothing in the proof stops them — that is a promise, not a property.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證明裡有一個號碼，你每次簽這面牆它都一樣。bonds.tw 說它不會保存、也不會公開。證明本身擋不住他們——那是一個承諾，不是一個性質。"
          }
        }
      }
    },
    "The proof carries two numbers that are the same for you every time. bonds.tw says it does not store them and does not publish them. Nothing in the proof stops them — that is a promise, not a property.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證明裡有兩個對你每次都一樣的號碼。bonds.tw 說它不會保存、也不會公開。證明本身擋不住他們——那是一個承諾，不是一個性質。"
          }
        }
      }
    },
    "The proof could not be created on this device.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置無法產生證明。"
          }
        }
      }
    },
    "The proof was sent and no answer came back. The wall keeps nothing that says which signature is yours, so this cannot be looked up — by anyone, including us. That is the same design that keeps it anonymous. Signing again may add a second signature.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證明送出去了，但答案沒有回來。這面牆不保存任何說明哪一筆是你的東西，所以這件事查不到——任何人都查不到，包括我們。讓它匿名的正是同一個設計。再簽一次可能會多一筆簽名。"
          }
        }
      }
    },
    "The proofs are not published, so nobody outside bonds.tw can recompute the number on the wall. Publishing them would leak the number above.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證明不會公開，所以 bonds.tw 以外的人沒辦法自己重算牆上的數字。公開證明會洩漏上面說的那個號碼。"
          }
        }
      }
    },
    "The proofs are not published, so nobody outside bonds.tw can recompute the number on the wall. Publishing them would leak the two numbers above.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證明不會公開，所以 bonds.tw 以外的人沒辦法自己重算牆上的數字。公開證明會洩漏上面說的那兩個號碼。"
          }
        }
      }
    },
    "The revocation list was applied but not checked against an authoritative source.": {
      "comment": "Limitation attached to a zero-knowledge proof",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已套用撤銷清單，但沒有與權威來源核對。"
          }
        }
      }
    },
    "The signature on this document is not valid; its contents may have been altered.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件的簽章無效，內容可能遭到竄改。"
          }
        }
      }
    },
    "The signature on this presentation is not valid.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次出示的簽章無效。"
          }
        }
      }
    },
    "The signature that came back does not match the document, so nothing was saved.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回傳的簽章與文件不符，因此沒有存下任何東西。"
          }
        }
      }
    },
    "The signature this proof is built from never changes and never expires. Anyone who has ever received a copy — 內政部 included — can keep making new proofs from it, on any device, without you.": {
      "comment": "Limitation attached to a zero-knowledge proof",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證明所依據的簽章永遠是同一份，也不會過期。任何拿過一次的人——包括內政部——都可以在你不在場、也不知情的情況下，用任何一台裝置繼續產生新的證明。"
          }
        }
      }
    },
    "The signing certificate is not on the revocation list stored on this device — but that list is more than three days old, so anything revoked since would not show here.": {
      "comment": "Shown alongside a successful offline verification",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署憑證不在這支手機儲存的撤銷名單上——但那份名單已超過三天，之後才被撤銷的憑證不會出現在這裡。"
          }
        }
      }
    },
    "The signing certificate was checked against a revocation list stored on this device and is not on it. That list has a date, and this app cannot confirm it is the genuine current one.": {
      "comment": "Shown alongside a successful offline verification",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拿簽署憑證對照這支手機上的撤銷名單，不在名單上。那份名單有它自己的製作時間，而這個 App 無法確認它是不是真正的當前版本。"
          }
        }
      }
    },
    "The signing request expired before it was approved on the certificate app.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽章請求在憑證 App 上完成核可前就過期了。"
          }
        }
      }
    },
    "The signing request expired before it was approved.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署請求在你確認之前就過期了。"
          }
        }
      }
    },
    "The three things people ask this app to prove, and which of them it only half answers.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "人們會要求這個 App 證明的三件事，以及其中哪些它只答得出一半。"
          }
        }
      }
    },
    "The two proofs are tied together": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩段證明互相扣住"
          }
        }
      }
    },
    "The valid document has been created": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正式證件已建立"
          }
        }
      }
    },
    "The verification files couldn't be downloaded.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證檔案下載失敗。"
          }
        }
      }
    },
    "The verification files on the server aren't the ones this app expects. Try again after updating the app.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器上的驗證檔案與這個版本的 App 預期的不符。請更新 App 後再試。"
          }
        }
      }
    },
    "The wall answered something this app cannot read.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這面牆回了一個這個 App 讀不懂的東西。"
          }
        }
      }
    },
    "The wall checked this proof and did not accept it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這面牆檢查了這份證明，沒有接受。"
          }
        }
      }
    },
    "The wall could not reach its checking service.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這面牆連不上檢查證明的服務。"
          }
        }
      }
    },
    "The wall counts signatures, not people. It could tell that the same person signed twice — that number in the proof would be identical — it says it does not look. Signing twice is two entries.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這面牆數的是簽名，不是人。它分得出來同一個人簽了兩次——證明裡那個號碼會一模一樣——它只是說它不看。簽兩次就是兩筆。"
          }
        }
      }
    },
    "The wall counts signatures, not people. It could tell that the same person signed twice — those two numbers in the proof would be identical — it says it does not look. Signing twice is two entries.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這面牆數的是簽名，不是人。它分得出來同一個人簽了兩次——證明裡那兩個號碼會一模一樣——它只是說它不看。簽兩次就是兩筆。"
          }
        }
      }
    },
    "The wall does not check that the certificate behind the proof was issued by 內政部. In this version the badge means a valid proof, not necessarily a real national ID card.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這面牆不檢查證明背後的憑證是不是內政部發的。在這個版本裡，徽章代表一份有效的證明，不一定代表一張自然人憑證。"
          }
        }
      }
    },
    "The wall does not check the revocation list. This app applies one when it makes the proof, but the wall does not look at it, so a card already reported lost still earns the badge.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這面牆不檢查撤銷清單。這支 App 做證明的時候套用了一份，但牆不看它，所以已經掛失的卡片一樣拿得到徽章。"
          }
        }
      }
    },
    "The wall does not recognise this one-time number.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這面牆不認這個一次性號碼。"
          }
        }
      }
    },
    "The wall has used up today's checks.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這面牆今天能付錢檢查的證明已經用完了。"
          }
        }
      }
    },
    "The 行動自然人憑證 app isn't installed on this device.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機沒有安裝行動自然人憑證 App。"
          }
        }
      }
    },
    "There is no document on this device to show yet.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置上還沒有可以出示的證件。"
          }
        }
      }
    },
    "There is nothing on this phone to show yet — back up your ID first.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機還沒有東西可以出示，請先備份你的身分證件。"
          }
        }
      }
    },
    "There isn't enough free space to prepare the verification files.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空間不足，無法準備驗證檔案。"
          }
        }
      }
    },
    "These are the plain documents your credentials came from. Deleting your credentials would not remove them.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是產生憑證的原始明文文件。刪除憑證並不會刪掉它們。"
          }
        }
      }
    },
    "These files have to be downloaded first": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些檔案要先下載"
          }
        }
      }
    },
    "These files have to be prepared first": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些檔案要先準備"
          }
        }
      }
    },
    "They did not show the name on the document, so this app could not check that the certificate above belongs to the same person.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方沒有出示證件上的姓名，所以本 App無法核對上面那張憑證是不是同一個人的。"
          }
        }
      }
    },
    "They held back %d more field(s). This app cannot tell which, only that the document commits to them.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方另外保留了 %d 個欄位。本 App看不出來是哪些，只知道證件裡確實承諾了它們。"
          }
        }
      }
    },
    "They say this check is for: %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方說這次查驗是為了：%@"
          }
        }
      }
    },
    "They signed this check with the key in their phone": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方用他手機裡的金鑰簽了這次查驗"
          }
        }
      }
    },
    "They signed this on %@. That time comes from their phone's clock, which this app cannot verify.": {
      "comment": "Verifier result sign-off",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方在 %@ 簽署了這次出示。時間以對方手機的時鐘為準，本 App 無法核實。"
          }
        }
      }
    },
    "Third Party Software License": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第三方軟體授權條款"
          }
        }
      }
    },
    "This app can't tell which authority issued your citizen certificate. Only certificates from MOICA G3 are supported.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法判斷你的自然人憑證由哪個憑證機構簽發；目前只支援內政部憑證管理中心第三代（G3）簽發的憑證。"
          }
        }
      }
    },
    "This app cannot check government certificates right now. This is a problem with the app, not with the document.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 目前無法查驗政府憑證。這是本 App 的問題，不是這份證件的問題。"
          }
        }
      }
    },
    "This app cannot check whether you already have a 行動自然人憑證 — only whether the app that holds it is installed here.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 App 查不到你有沒有行動自然人憑證，只查得到裝著它的那個 App 有沒有裝在這裡。"
          }
        }
      }
    },
    "This app does not have permission to use the camera, so it cannot read the code.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 沒有相機權限，無法讀取條碼。"
          }
        }
      }
    },
    "This app is not allowed to use Bluetooth. You can change that in Settings.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 App 沒有被允許使用藍牙。可以到「設定」裡更改。"
          }
        }
      }
    },
    "This app is too old to read this proof.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個 App 版本太舊，讀不了這份證明。"
          }
        }
      }
    },
    "This build can't request a signature: it has no credentials for the digital certificate service.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個版本無法送出簽章請求：它沒有內政部的 SP 憑據。"
          }
        }
      }
    },
    "This build has no credentials for the digital certificate service, so it can't request a signature.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個版本沒有內政部的 SP 憑據，無法送出簽章請求。"
          }
        }
      }
    },
    "This card could not be checked. Open it for details.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張卡沒能通過檢查。點開看細節。"
          }
        }
      }
    },
    "This certificate can't be used to create a proof.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張憑證無法用來產生證明。"
          }
        }
      }
    },
    "This check cannot confirm that the person in front of you is the one who answered it. The answer may have been obtained somewhere else and passed on.": {
      "comment": "Shown alongside a successful offline verification",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次查驗無法確認眼前這個人就是回應的那一方。這份答案有可能是在別處取得後轉傳過來的。"
          }
        }
      }
    },
    "This check was made offline. Nothing was sent to any server.": {
      "comment": "Shown alongside a successful offline verification",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次查驗未連線，未向任何伺服器傳送資料。"
          }
        }
      }
    },
    "This checker had no request outstanding. Each request can be answered once; start a new check and ask them to scan it again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你這邊現在沒有在等任何人回應。每個請求只能回應一次，請重新開始查驗，再請對方掃描一次。"
          }
        }
      }
    },
    "This checker's code did not offer Bluetooth, so the codes above are the only way across.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這位查驗方的條碼沒有提供藍牙，所以上面的條碼是唯一的傳遞方式。"
          }
        }
      }
    },
    "This code carries a one-time number. Their document has to answer this exact number, so a photograph of an earlier check cannot be reused here.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個條碼帶著一組一次性的數字。對方的證件必須回應這組數字，所以先前查驗的翻拍照片在這裡無法重複使用。"
          }
        }
      }
    },
    "This code is dated ahead of your phone's clock": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個條碼的時間比你手機的時鐘還晚"
          }
        }
      }
    },
    "This code is not a document presented by this app.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個條碼不是本 App 出示的證件。"
          }
        }
      }
    },
    "This code stops being accepted about five minutes after it was made.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個條碼產生約五分鐘後就不再被接受。"
          }
        }
      }
    },
    "This code was not made just now": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個條碼不是剛才產生的"
          }
        }
      }
    },
    "This device can't check the proof yet: the verification keys aren't downloaded.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機還沒辦法驗證這份證明：驗證金鑰尚未下載。"
          }
        }
      }
    },
    "This device cannot use Bluetooth for this.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置無法用藍牙做這件事。"
          }
        }
      }
    },
    "This device checked the proof and it did not pass.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機驗過了，這份證明沒有通過。"
          }
        }
      }
    },
    "This device checked the proof and refused it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機檢查了這份證明，並判定不通過。"
          }
        }
      }
    },
    "This device could not create a signing key.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置無法建立簽署金鑰。"
          }
        }
      }
    },
    "This device could not create a verification request.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置無法建立查驗請求。"
          }
        }
      }
    },
    "This device could not draw a Bluetooth pairing code. You can still load a proof from a file.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機畫不出藍牙配對碼。你仍然可以從檔案載入證明。"
          }
        }
      }
    },
    "This device could not generate a secure random number.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機無法產生安全的亂數。"
          }
        }
      }
    },
    "This device couldn't finish checking the proof.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機無法完成驗證。"
          }
        }
      }
    },
    "This device does not have the files needed to check a proof yet.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機還沒有查驗證明所需的檔案。"
          }
        }
      }
    },
    "This device has a Secure Enclave": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置有安全隔離區"
          }
        }
      }
    },
    "This device has a Secure Enclave but the key was not put in it. Anyone who can read the Keychain could sign credentials as you.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置有安全隔離區，金鑰卻沒放進去。能讀取 Keychain 的人就能冒用你的身分簽發憑證。"
          }
        }
      }
    },
    "This device has no camera available, so codes cannot be scanned here.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置沒有可用的相機，無法在這裡掃描條碼。"
          }
        }
      }
    },
    "This device is already creating a proof.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置正在產生證明。"
          }
        }
      }
    },
    "This document": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件"
          }
        }
      }
    },
    "This document belongs to someone other than the person presenting it.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件的持有人不是出示的人。"
          }
        }
      }
    },
    "This document could not be prepared for sending.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件無法準備傳送。"
          }
        }
      }
    },
    "This document could not be shown": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件無法出示"
          }
        }
      }
    },
    "This document could not be signed on this device.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件無法在此裝置上簽署。"
          }
        }
      }
    },
    "This document could not be turned into a code on this device.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置無法把這份證件轉成條碼。"
          }
        }
      }
    },
    "This document disclosed %d more field(s) that are not shown here.": {
      "comment": "Shown when a presentation carries more fields than the screen draws",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份文件還出示了 %d 個欄位，這裡沒有顯示。"
          }
        }
      }
    },
    "This document disclosed no fields.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件沒有揭露任何欄位。"
          }
        }
      }
    },
    "This document does not fit in one code, so it cycles through %1$d — one full cycle takes about %2$d seconds. Keep the screen still until the checker's phone says it has them all; the order does not matter.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件放不進一張碼，會輪流顯示 %1$d 張——轉完一輪約 %2$d 秒。請把螢幕拿穩，直到查驗方的手機說全部收到為止；順序沒有影響。"
          }
        }
      }
    },
    "This document does not match the signature on it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份文件與它上面的簽章不符。"
          }
        }
      }
    },
    "This document does not say when it becomes valid.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件沒有記載生效時間。"
          }
        }
      }
    },
    "This document does not state an expiry date.": {
      "comment": "Shown alongside a successful offline verification",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件沒有記載有效期限。"
          }
        }
      }
    },
    "This document has expired.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件已過期。"
          }
        }
      }
    },
    "This document is in a format this app cannot read.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件的格式，本 App 讀不懂。"
          }
        }
      }
    },
    "This document is not valid yet.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件尚未生效。"
          }
        }
      }
    },
    "This document is signed in a way this app cannot check.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件的簽章方式本 App 無法查驗。"
          }
        }
      }
    },
    "This document names one signer but is signed under another.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件標示的簽署者與實際簽章的金鑰不符。"
          }
        }
      }
    },
    "This document uses fields this app does not understand.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件含有本 App 無法解讀的欄位。"
          }
        }
      }
    },
    "This document was created by an older version of the app and cannot be shown in part. Every field in it will be shown: name, ID number, date of birth, household address and nationality.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件是舊版本建立的，無法只出示一部分。裡面每個欄位都會被看到：姓名、統一編號、出生日期、戶籍地址與國籍。"
          }
        }
      }
    },
    "This document was created under an identifier this device no longer has.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件是用這台裝置已經沒有的識別碼建立的。"
          }
        }
      }
    },
    "This document was issued by someone this app has no way to check.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件的簽發者本 App 無從查驗。"
          }
        }
      }
    },
    "This document was issued by the holder's own device, not by a government authority.": {
      "comment": "Shown alongside a successful offline verification",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件由持證人的裝置自行簽發，並非政府機關簽發。"
          }
        }
      }
    },
    "This document was signed by a different person from the one it describes.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署這份文件的人，與文件所描述的人不是同一位。"
          }
        }
      }
    },
    "This document's identifier is not one this app can check.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件的識別碼不是本 App 能查驗的格式。"
          }
        }
      }
    },
    "This download is already running.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個下載已經在進行中。"
          }
        }
      }
    },
    "This download needs Wi-Fi or full cellular data. Check your connection, or turn off Low Data Mode.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個下載需要 Wi-Fi 或完整行動網路。請檢查連線，或關閉低數據模式。"
          }
        }
      }
    },
    "This downloads %@ and uses about %@ on this device. They're the mathematical circuits used to create and check the proof, published by the Privacy & Scaling Explorations team. They stay on your phone and are only downloaded once.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會下載 %@，並在這支手機上佔用約 %@。這些是用來產生與驗證證明的數學電路，由 Privacy & Scaling Explorations 團隊發布。檔案只留在你的手機上，而且只需要下載一次。"
          }
        }
      }
    },
    "This field was too long to show in full.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個欄位太長，沒有完整顯示。"
          }
        }
      }
    },
    "This is a mismatch between this app and the wall.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是這個 App 跟牆之間對不上。"
          }
        }
      }
    },
    "This is a stored document rather than a presentation made for this check.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是已儲存的證件本身，不是為本次查驗簽出的出示檔。"
          }
        }
      }
    },
    "This is about this phone, not about the person presenting. What they showed was never examined, so nothing here counts against them.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是這台手機的狀態，不是對出示者的判斷。他們出示的內容根本沒有被檢查，所以這裡沒有任何一項對他們不利。"
          }
        }
      }
    },
    "This is the only thing in this app that sends anything to a server. About 250 KB of proof goes over the internet.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是這支 App 裡唯一會把東西送到伺服器的動作。大約 250 KB 的證明會經由網路送出去。"
          }
        }
      }
    },
    "This one-time number has already been used.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個一次性號碼已經用掉了。"
          }
        }
      }
    },
    "This phone checked the mathematics and it passed. The wall checks the mathematics **and** which service the proof was made for **and** whether it is bound to the number the wall just issued — the last two are things this phone cannot check by itself. So this usually means the wall's settings and this app disagree, not that there is anything wrong with your card. Nothing was published. This is worth reporting.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機檢查的是數學，而且通過了。牆檢查的是數學、加上這份證明是為哪個服務做的、加上它綁的是不是牆剛剛發出的那個號碼——這兩件事這支手機沒有辦法自己檢查。所以這通常代表牆那邊的設定和這支 App 對不上，不代表你的卡片有問題。沒有任何東西被公開。這件事值得回報。"
          }
        }
      }
    },
    "This phone checked the proof and refused it": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機查驗了這份證明，判定不通過"
          }
        }
      }
    },
    "This phone could not make itself discoverable (%@).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機無法讓自己被找到（%@）。"
          }
        }
      }
    },
    "This phone did not check the proof itself, so there is nothing to compare against. Nothing was published.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機沒有自己檢查過這份證明，所以沒有東西可以拿來比對。沒有任何東西被公開。"
          }
        }
      }
    },
    "This phone — nobody else vouches for these values.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機——沒有任何其他人為這些內容背書。"
          }
        }
      }
    },
    "This phone's date is earlier than %@, when the certificate on this document starts being valid — so nothing about the document could be checked. Check this phone's date and time.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機的日期早於 %@——那是這份證件上的憑證開始生效的日子——所以沒有對這份證件做過任何查驗。請檢查這支手機的日期與時間。"
          }
        }
      }
    },
    "This presentation answers a different check, so it may be a copy of an earlier one.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方回的不是你這一次的查驗，可能是他上一次出示留下來的複本。"
          }
        }
      }
    },
    "This presentation carries more than one document, which this app cannot check yet.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次出示包含多份證件，本 App 尚無法查驗。"
          }
        }
      }
    },
    "This presentation has expired. Ask for it to be shown again.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次出示已逾時，請對方重新出示。"
          }
        }
      }
    },
    "This presentation is not tied to this checker specifically.": {
      "comment": "Shown alongside a successful offline verification",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次出示不是指定給你的。"
          }
        }
      }
    },
    "This presentation was made for a different checker.": {
      "comment": "Offline verification failure",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次出示是給別的查驗方的。"
          }
        }
      }
    },
    "This proof cannot show whether the same identity has already been used elsewhere.": {
      "comment": "Limitation attached to a zero-knowledge proof",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個證明無法顯示同一個身分是否已經在別處用過。"
          }
        }
      }
    },
    "This proof carries the same personal number every time and to every checker, so any two checkers can tell it was the same person. It hides who you are, not that you are the same one.": {
      "comment": "Limitation attached to a zero-knowledge proof",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證明每次、對每一位查驗方都帶著同一組去重編號，任兩位查驗方都能比對出是同一個人。它藏得住你是誰，藏不住你是同一個人。"
          }
        }
      }
    },
    "This proof could not be packaged": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證明無法打包"
          }
        }
      }
    },
    "This proof could not be sent": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證明無法傳送"
          }
        }
