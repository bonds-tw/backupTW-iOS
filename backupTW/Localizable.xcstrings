          }
        }
      }
    },
    "Saves a %@ file. Too large for a QR code — send it as a file.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存成一個 %@ 的檔案。太大了塞不進 QR code——請用檔案傳送。"
          }
        }
      }
    },
    "Scan a QR from 數位憑證皮夾 to add a card issued by a government body.": {
      "localizations": {
        "zh-Hant": {
