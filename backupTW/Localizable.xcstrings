      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有備而來"
          }
        }
      }
    },
    "Both circuits completed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩組電路都完成了"
          }
        }
