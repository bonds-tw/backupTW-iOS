      }
    },
    "Prove you hold a valid 自然人憑證 without showing it. Needs a large one-time download.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證明你持有有效的自然人憑證，但不出示憑證內容。需要一次性的大量下載。"
          }
        }
      }
    },
    "Prove you once held a Taiwanese national ID": {
