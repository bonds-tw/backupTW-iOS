      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對方會看到的查驗事由：%@"
          }
        }
      }
    },
    "Reason the checker gave" : {
      "localizations" : {
        "zh-Hant" : {
