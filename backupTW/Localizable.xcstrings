      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證鏈 %@ · 簽章 %@ · 同一人 %@"
          }
        }
      }
    },
    "Certificate chain checking key": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證鏈驗證金鑰"
          }
        }
      }
    },
    "Certificate chain proving key": {
      "comment": "ZK circuit asset",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證鏈證明金鑰"
          }
        }
      }
    },
    "Certificate revocation snapshot": {
      "comment": "ZK circuit asset",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證撤銷清單快照"
          }
        }
      }
    },
    "Check a document": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查驗證件"
          }
        }
      }
    },
    "Check a document someone shows you, without contacting any server.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查驗別人出示的證件，全程不連任何伺服器。"
          }
        }
      }
    },
    "Check a proof": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查驗證明"
          }
        }
      }
    },
    "Check a proof file. Needs the large checking files on this phone.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查驗一個證明檔案。這支手機上要先有那組很大的查驗檔案。"
          }
        }
      }
    },
    "Check a zero-knowledge proof": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查驗零知識證明"
          }
        }
      }
    },
    "Check result": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查驗結果"
          }
        }
      }
    },
    "Check someone else's document": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查驗他人證件"
          }
        }
      }
    },
    "Check the proof on this device": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這支手機上驗證證明"
          }
        }
      }
    },
    "Checked in %@, with no network": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 完成驗證，全程未連網"
          }
        }
      }
    },
    "Checked on this device: the proof does not hold": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在這支手機上驗證：證明不成立"
          }
        }
      }
    },
    "Checked on this device: the proof holds": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在這支手機上驗證：證明成立"
          }
        }
      }
    },
    "Checked on this phone, and it passed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這支手機上查驗過，通過"
          }
        }
      }
    },
    "Checking what's already downloaded…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查已經下載了哪些檔案…"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查驗中…"
          }
        }
      }
    },
    "Choose a proof file": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇證明檔案"
          }
        }
      }
    },
    "Code %1$d of %2$d": {
      "comment": "Carousel position",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$d／%2$d 張"
          }
        }
      }
    },
    "Confirm": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續"
          }
        }
      }
    },
    "Copied": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已複製"
          }
        }
      }
    },
    "Could not reach the digital certificate service.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到行動自然人憑證服務。"
          }
        }
      }
    },
    "Could not read": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取"
          }
        }
      }
    },
    "Couldn't check the verification files.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查驗證檔案。"
          }
        }
      }
    },
    "Create a Valid Document": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立正式證件"
          }
        }
      }
    },
    "Create a proof": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始產生證明"
          }
        }
      }
    },
    "Create a valid document from the home screen first. Nothing can be shown until this device holds one.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先從首頁建立有效證件。這台裝置還沒有證件之前，沒有東西可以出示。"
          }
        }
      }
    },
    "Create the proof": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生證明"
          }
        }
      }
    },
    "Created": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立時間"
          }
        }
      }
    },
    "Creates a mathematical proof that your 自然人憑證 was issued by 內政部憑證管理中心, and checks its serial number against a revocation list this app cannot confirm is complete. The person checking the proof never sees your name, your ID number, or the certificate itself.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生一份數學證明，說明你的自然人憑證是由內政部憑證管理中心簽發，並把序號拿去比對一份撤銷清單——但這個 App 無法確認那份清單是完整的。查驗證明的人不會看到你的姓名、身分證統一編號，也不會看到憑證本身。"
          }
        }
      }
    },
    "Credential store": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑證儲存區"
          }
        }
      }
    },
    "Data and Privacy": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料與隱私"
          }
        }
      }
    },
    "Date of birth": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出生年月日"
          }
        }
      }
    },
    "Diagnostics": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "診斷"
          }
        }
      }
    },
    "Document code": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證件條碼"
          }
        }
      }
    },
    "Document information": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證件資料"
          }
        }
      }
    },
    "Document-level signature": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件級簽章"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Download": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載"
          }
        }
      }
    },
    "Download %@ · %@ on disk": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載 %@ · 佔用 %@"
          }
        }
      }
    },
    "Download %@ · uses %@ on this device": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載 %@ · 在這支手機上佔用 %@"
          }
        }
      }
    },
    "Download the verification files?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要下載驗證檔案嗎？"
          }
        }
      }
    },
    "Downloaded and installed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已下載並安裝"
          }
        }
      }
    },
    "Erase": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除"
          }
        }
      }
    },
    "Erase all local data": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除所有本機資料"
          }
        }
      }
    },
    "Erase all local data?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除所有本機資料嗎？"
          }
        }
      }
    },
    "Erasing really gives you a new identity": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除之後真的會換一個新身分"
          }
        }
      }
    },
    "Error": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錯誤"
          }
        }
      }
    },
    "Every field in your document: name, ID number, date of birth, household address and nationality. This version cannot show only part of it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證件裡的每一個欄位：姓名、統一編號、出生日期、戶籍地址與國籍。這個版本無法只出示其中一部分。"
          }
        }
      }
    },
    "Every time you show this document it reveals the same identifier. Different checkers can compare notes and tell it was you both times.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證件每次出示都會露出同一組識別碼。不同的查驗者只要互相比對，就能看出兩次都是你。"
          }
        }
      }
    },
    "Excluded from backup": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已排除備份"
          }
        }
      }
    },
    "Expected here — there is no Secure Enclave to use.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡本來就是這樣——沒有安全隔離區可用。"
          }
        }
      }
    },
    "Experimental": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實驗中"
          }
        }
      }
    },
    "Fetch it again and replace what's stored.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新抓一次，取代目前存的這份。"
          }
        }
      }
    },
    "Field named by their document: “%@”": {
      "comment": "Heading for a disclosed field whose name this build does not know",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方文件自訂的欄位「%@」"
