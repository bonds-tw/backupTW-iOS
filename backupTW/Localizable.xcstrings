        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試辦準備狀態"
          }
        }
      }
    },
    "Prove a city, district, residence, or ownership condition without exposing a complete address, household, parcel, or encumbrance record.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
