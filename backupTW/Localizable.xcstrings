      }
    },
    "Can't start": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開始"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
