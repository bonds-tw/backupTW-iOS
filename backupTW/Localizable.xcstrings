        }
      }
    },
    "This proof passed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證明通過了"
          }
        }
      }
    },
    "This proof was made by a newer version of the app. Update this app, then check it again.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證明是較新版本的 App 產生的。請先更新這個 App，再查驗一次。"
          }
        }
      }
    },
    "This proof was refused": {
