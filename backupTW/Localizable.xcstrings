    "Files in Documents": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents 裡的檔案"
          }
        }
      }
    },
    "For this unzipping only, not to be used for any other purpose.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用於此次解壓縮，絕不另作他用"
          }
        }
      }
    },
    "Go to Application Guide": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往申辦指南"
          }
        }
      }
    },
    "Hand this proof to a verifier": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把這份證明交給查驗方"
          }
        }
      }
    },
    "Hidden while this app is not in front": {
      "comment": "App switcher privacy cover",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
