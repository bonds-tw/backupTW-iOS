{
  "sourceLanguage": "en",
  "strings": {
    "%.1f s": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f 秒"
          }
        }
      }
    },
    "%@ already on this device": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支手機上已有 %@"
          }
        }
      }
    },
    "%d fields · created %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 個欄位 · %@ 建立"
          }
        }
      }
    },
    "%d file(s) left over: %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "殘留 %d 個檔案：%@"
          }
        }
      }
    },
    "%llu ms": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%llu 毫秒"
          }
        }
      }
    },
    "(blank)": {
      "comment": "A disclosed field whose value is empty",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（空白）"
          }
        }
      }
    },
    "A file this app ships with is missing.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 內建的檔案遺失了。"
          }
        }
      }
    },
    "A fresh identifier was issued": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生了全新的識別碼"
          }
        }
      }
    },
    "A proof was created but nothing checked it": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已產生證明，但沒有任何人驗過它"
          }
        }
      }
    },
    "A refusal is not proof of a forgery. A wrong clock, a partial scan, or an out-of-date app produce the same answer.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「未通過」不等於偽造。裝置時間不準、條碼沒掃完、App 版本太舊，都會得到同樣的結果。"
          }
        }
      }
    },
    "A stored credential is damaged and cannot be read.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的憑證損毀，無法讀取。"
          }
        }
      }
    },
    "A zero-knowledge proof is about 290 KB — too large for a QR code, so it arrives as a file.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "零知識證明大約 290 KB——太大了塞不進 QR code，所以是用檔案傳過來的。"
          }
        }
      }
    },
    "A123456789": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "A123456789"
          }
        }
      }
    },
    "About Bond": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於有備而來"
          }
        }
      }
    },
    "Address of household": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "戶籍地址"
          }
        }
      }
    },
    "All information are stored only on your phone.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有資料僅儲存在你的手機中。"
          }
        }
      }
    },
    "Already prepared": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經備妥"
          }
        }
      }
    },
    "Answer a checker's code. Works with no network on either phone.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描查驗者的條碼並回應，兩支手機都不需要網路。"
          }
        }
      }
    },
    "Ask the other person to scan this": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請對方掃描這個條碼"
          }
        }
      }
    },
    "Back up my national ID": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份我的身分證件"
          }
        }
      }
    },
    "Back up your national ID from the home screen first.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先從首頁備份你的身分證件。"
          }
        }
      }
    },
    "Before you start": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始之前"
          }
