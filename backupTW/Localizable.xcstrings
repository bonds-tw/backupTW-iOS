            "state": "translated",
            "value": "掃描卡片 QR"
          }
        }
      }
    },
    "Scan a verifier's QR": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描查驗方的 QR"
          }
        }
      }
    },
    "Scan a verifier's QR and choose exactly what to show.": {
      "localizations": {
        "zh-Hant": {
