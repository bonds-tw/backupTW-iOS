          "stringUnit": {
            "state": "translated",
            "value": "國民身分證金鑰簽章"
          }
        }
      }
    },
    "Not checked: Arbitrum could not be reached. The API record is still shown below.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未查核：目前無法連線 Arbitrum。下方仍會顯示 API 紀錄。"
          }
        }
      }
    },
    "Not present in this older document": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此舊版證件未包含"
          }
        }
      }
    },
    "Not verified: the transaction, contract, receipt or recorded values differ from the official API.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查核未通過：交易、合約、收據或紀錄內容與官方 API 不同。"
          }
        }
      }
    },
    "Not verified: this API entry has no blockchain record.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查核未通過：這筆 API 資料沒有區塊鏈紀錄。"
          }
        }
      }
    },
    "Official API loaded · Arbitrum is temporarily unavailable": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已載入官方 API · Arbitrum 暫時無法使用"
          }
        }
      }
    },
    "Official API loaded · Checking Arbitrum…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已載入官方 API · 正在查核 Arbitrum…"
          }
        }
      }
    },
    "Official API": {
      "comment": "trust record source",
      "localizations": {
        "zh-Hant": {
