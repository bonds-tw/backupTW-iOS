        }
      }
    },
    "Official API connected · Blockchain check is temporarily unavailable": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "官方 API 已連線 · 區塊鏈查核暫時無法使用"
          }
        }
      }
    },
    "Official API matches the current Arbitrum registry state": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "官方 API 與 Arbitrum 合約目前狀態相符"
          }
        }
      }
    },
    "Open blockchain record": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟區塊鏈紀錄"
          }
        }
      }
    },
    "Open official API record": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟官方 API 紀錄"
          }
        }
      }
    },
    "frontend.wallet.gov.tw · Original record": {
      "comment": "short API link label",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "frontend.wallet.gov.tw · 原始紀錄"
          }
        }
      }
    },
    "Loaded %d organisations from the official API. A green check means the API record is available; a shield means its current blockchain record also matches.": {
      "comment": "trust list status legend",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已從官方 API 載入 %d 個機構。綠勾代表 API 紀錄可用；盾牌代表目前的區塊鏈紀錄也相符。"
          }
        }
      }
    },
    "Organisation": {
      "comment": "field label",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "組織"
          }
        }
      }
    },
    "Original file, protected on this phone and excluded from backups": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始檔，僅在此手機上受保護，且不納入備份"
          }
        }
      }
    },
    "Private key": {
      "comment": "wallet identity field",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私密金鑰"
          }
        }
      }
    },
    "Protected by iOS Keychain": {
      "comment": "wallet identity key backing",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 iOS 鑰匙圈保護"
          }
        }
      }
    },
    "Registry contract": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀錄合約"
          }
        }
      }
