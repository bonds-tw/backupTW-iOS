          "stringUnit": {
            "state": "translated",
            "value": "選擇要讓對方看到什麼"
          }
        }
      }
    },
    "Choose your mobile carrier. Its app opens to verify the number on your line.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你的電信業者，會開啟該業者的 App 驗證你門號上的號碼。"
          }
        }
      }
    },
