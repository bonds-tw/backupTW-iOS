        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份證明被拒絕"
          }
        }
      }
    },
    "This proves who issued the certificate, not that it is still valid today.": {
      "comment": "Limitation attached to a zero-knowledge proof",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這只證明憑證由誰簽發，不證明它今天仍然有效。"
