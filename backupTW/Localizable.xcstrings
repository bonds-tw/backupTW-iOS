        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從相簿選 QR"
          }
        }
      }
    },
    "Choose a document to bring in from Taiwan's MyData service.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要從台灣 MyData 服務匯入的文件。"
