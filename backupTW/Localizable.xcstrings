          }
        }
      }
    },
    "Prove coverage was active on a requested date without revealing employer history, salary basis, or unrelated periods.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證明指定日期的投保有效，不揭露雇主紀錄、投保薪資或無關期間。"
          }
        }
      }
    },
    "Remember MyData details on this iPhone": {
