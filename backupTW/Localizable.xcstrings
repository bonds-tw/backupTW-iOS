    "Removes your credentials, the documents they came from, and the key that identifies you.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會刪除你的憑證、產生憑證的原始文件，以及識別你的金鑰。"
