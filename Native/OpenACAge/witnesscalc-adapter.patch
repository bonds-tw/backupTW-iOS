+    // Current Xcode no longer supports the upstream iOS 8 defaults. Keep the
+    // native C/C++ and Rust deployment floors aligned with the app, and avoid
+    // building the other simulator architecture when Cargo requested exactly
+    // one. The upstream helper otherwise builds both arm64 and x86_64 GMP,
+    // requiring nasm and several extra gigabytes for an Intel slice this app
+    // cannot use.
+    let gmp_script_path = witnesscalc_path.join("build_gmp.sh");
+    if let Ok(script) = fs::read_to_string(&gmp_script_path) {
+        let mut script = script
+            .replace(
+                "export MIN_IOS_VERSION=8.0",
+                "export MIN_IOS_VERSION=16.0\n    export CC_FOR_BUILD=\"$(xcrun --sdk macosx --find clang) -isysroot $(xcrun --sdk macosx --show-sdk-path) -mmacosx-version-min=14.0\"",
+            )
+            .replace("-miphoneos-version-min=8.0", "-miphoneos-version-min=16.0")
+            .replace("-mios-simulator-version-min=8.0", "-mios-simulator-version-min=16.0");
+        script = script.replace(
+            "build_ios_simulator()\n{\n",
+            "build_ios_simulator()\n{\n\texport CC_FOR_BUILD=\"$(xcrun --sdk macosx --find clang) -isysroot $(xcrun --sdk macosx --show-sdk-path) -mmacosx-version-min=14.0\"\n",
+        );
+        if target == "aarch64-apple-ios-sim" {
+            script = script.replace(
+                "for ARCH in \"arm64\" \"x86_64\"; do",
+                "for ARCH in \"arm64\"; do",
+            );
+        } else if target == "x86_64-apple-ios" {
+            script = script.replace(
+                "for ARCH in \"arm64\" \"x86_64\"; do",
+                "for ARCH in \"x86_64\"; do",
+            );
+        }
+        fs::write(&gmp_script_path, script).expect("Failed to pin the iOS GMP build");
+    }
+
