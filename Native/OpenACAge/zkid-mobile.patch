+// The upstream native witness calculator performs large secp256r1/GMP
+// operations on the calling thread. The default macOS main-thread stack and
+// iOS worker stacks are too small for the 2K JWT circuit and terminate with a
+// stack-guard SIGBUS. Keep the large stack scoped to proof generation rather
+// than requiring an application-wide process limit.
+const PROVER_STACK_BYTES: usize = 64 * 1024 * 1024;
+
+fn run_prover_on_large_stack<F>(name: &str, operation: F) -> Result<(), ZkProofError>
+where
+    F: FnOnce() + Send + 'static,
+{
+    let handle = std::thread::Builder::new()
+        .name(name.to_owned())
+        .stack_size(PROVER_STACK_BYTES)
+        .spawn(operation)
+        .map_err(|error| ZkProofError::ProofGenerationFailed {
+            message: format!("failed to start prover thread: {error}"),
+        })?;
+    handle
+        .join()
+        .map_err(|_| ZkProofError::ProofGenerationFailed {
+            message: "native prover terminated unexpectedly".to_owned(),
+        })
+}
